{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "off",
        "noControlCharactersInRegex": "off",
        "noImplicitAnyLet": "off"
      }
    }
  },
  "files": {
    "includes": ["**", "!dist", "!dist", "!node_modules", "!node_modules", "!resources", "!resources"]
  }
}
