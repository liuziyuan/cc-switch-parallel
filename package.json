{
  "name": "cc-switch-parallel",
  "version": "0.21.7",
  "description": "A companion launcher for cc-switch — run Claude Code and Codex with per-provider isolated configs in parallel terminals, no switching required",
  "license": "MIT",
  "type": "module",
  "bin": {
    "switch": "./dist/cc-launch.mjs"
  },
  "files": [
    "dist",
    "resources"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --import tsx --test \"test/*.test.mjs\"",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "smol-toml": "^1.7.1"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuziyuan/cc-switch-parallel.git"
  },
  "homepage": "https://github.com/liuziyuan/cc-switch-parallel",
  "keywords": [
    "claude-code",
    "codex",
    "cc-switch",
    "provider",
    "parallel",
    "isolation",
    "cli"
  ],
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
